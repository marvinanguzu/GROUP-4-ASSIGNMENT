G = epanet('water_system.inp');
Fmean = mean(G.getComputedHydraulicTimeSeries('flow').Flow,1);

Fsign = sign(Fmean);
Nidx = G.getLinkNodesIndex;
for i = 1:size(Nidx,1)
    if Fsign(i) == 1
        A(Nidx(i,1),Nidx(i,2)) = 1;
    else
        A(Nidx(i,2),Nidx(i,1)) = 1;
    end
end
